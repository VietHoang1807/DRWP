# dev: đăng nhập bằng POST /dev/token (backend profile dev). oidc: Keycloak PKCE.
VITE_AUTH_MODE=dev
# Để trống khi dùng proxy Vite (khuyến nghị). Đặt URL đầy đủ nếu FE và API khác origin (cần CORS).
VITE_API_BASE_URL=
VITE_OIDC_ISSUER=http://localhost:8180/realms/drwp
VITE_OIDC_CLIENT_ID=drwp-web
# Dùng bởi vite.config.ts (proxy) và scripts/seed.mjs
DRWP_BACKEND_URL=http://localhost:8080
