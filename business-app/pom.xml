<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>vn.drwp</groupId>
        <artifactId>drwp-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>business-app</artifactId>
    <name>DRWP :: Business App (deployable #2; runtime roles api / event-worker / scheduled-worker)</name>

    <dependencies>
        <dependency><groupId>vn.drwp</groupId><artifactId>module-tenant</artifactId></dependency>
        <dependency><groupId>vn.drwp</groupId><artifactId>module-identity</artifactId></dependency>
        <dependency><groupId>vn.drwp</groupId><artifactId>module-metadata</artifactId></dependency>
        <dependency><groupId>vn.drwp</groupId><artifactId>module-record</artifactId></dependency>
        <dependency><groupId>vn.drwp</groupId><artifactId>module-workflow</artifactId></dependency>
        <dependency><groupId>vn.drwp</groupId><artifactId>module-file</artifactId></dependency>
        <dependency><groupId>vn.drwp</groupId><artifactId>module-notification</artifactId></dependency>
        <dependency><groupId>vn.drwp</groupId><artifactId>module-audit</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId></dependency>
        <dependency><groupId>io.micrometer</groupId><artifactId>micrometer-registry-prometheus</artifactId></dependency>
        <dependency><groupId>org.springframework.modulith</groupId><artifactId>spring-modulith-actuator</artifactId><scope>runtime</scope></dependency>

        <!-- test -->
        <dependency><groupId>org.springframework.modulith</groupId><artifactId>spring-modulith-starter-test</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.springframework.modulith</groupId><artifactId>spring-modulith-docs</artifactId><scope>test</scope></dependency>
        <dependency><groupId>com.tngtech.archunit</groupId><artifactId>archunit-junit5</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.springframework.security</groupId><artifactId>spring-security-test</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.testcontainers</groupId><artifactId>testcontainers-postgresql</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.testcontainers</groupId><artifactId>testcontainers-junit-jupiter</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.awaitility</groupId><artifactId>awaitility</artifactId><scope>test</scope></dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
